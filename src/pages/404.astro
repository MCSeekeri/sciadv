---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
---
<MainGridLayout title="404" description="请求的页面不存在。">
	<div class="card-base px-6 py-8 md:px-9 md:py-10">
		<p class="text-sm font-medium uppercase tracking-[0.2em] text-[var(--primary)]">
			404
		</p>
		<h1 class="mt-3 text-3xl font-bold text-90 md:text-4xl">页面不存在</h1>
		<p class="mt-4 text-75">
			你访问的页面不存在，可能已被移动、删除，或链接本身有误。
		</p>
		<div class="mt-6 flex flex-wrap gap-3">
			<a href={url("/")} class="btn-regular rounded-xl px-5 h-11 font-bold">
				{i18n(I18nKey.home)}
			</a>
			<a href={url("/archives/")} class="btn-plain rounded-xl px-5 h-11 font-bold">
				{i18n(I18nKey.archive)}
			</a>
		</div>
	</div>
</MainGridLayout>
