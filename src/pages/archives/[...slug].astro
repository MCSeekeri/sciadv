---
import path from "node:path";
import Comment from "@components/Comment.svelte";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getEntrySlug, getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { render, type CollectionEntry } from "astro:content";
import { licenseConfig, walineConfig } from "src/config";
import { authors } from "../../authors";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import katexCssUrl from "katex/dist/katex.css?url";
import photoswipeCssUrl from "photoswipe/style.css?url";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: getEntrySlug(entry) },
		props: { entry },
	}));
}

const { entry } = Astro.props as { entry: CollectionEntry<"archives"> };
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const authorId = entry.data.author;
const author =
	authorId && authors[authorId]
		? authors[authorId]
		: { name: profileConfig.name, url: Astro.site?.toString() || "" };

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: author.name,
		url: author.url,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.date),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---
<MainGridLayout banner={entry.data.image ?? undefined} title={entry.data.title} description={entry.data.description ?? undefined} lang={entry.data.lang} setOGTypeArticle={true} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <link rel="stylesheet" href={katexCssUrl} slot="head" />
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" data-photoswipe-style-url={photoswipeCssUrl} class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.data.title}
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        date={entry.data.date}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        categories={entry.data.categories}
                        authorId={entry.data.author}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper
                    id="post-cover"
                    src={entry.data.image}
                    basePath={path.join("content/archives/", getDir(entry.id))}
                    class="mb-8 rounded-xl banner-container onload-animation"
                    priority={true}
                    sizes="100vw"
                />
            }


            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={entry.data.title} slug={getEntrySlug(entry)} pubDate={entry.data.date} authorId={entry.data.author} references={entry.data.references} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>

    {walineConfig.enable && walineConfig.serverURL && (
        <Comment 
            client:visible
            serverURL={walineConfig.serverURL}
            path={walineConfig.path || Astro.url.pathname}
            lang={walineConfig.lang || entry.data.lang || siteConfig.lang}
            locale={walineConfig.locale}
            emoji={walineConfig.emoji}
            dark={walineConfig.dark}
            meta={walineConfig.meta}
            requiredMeta={walineConfig.requiredMeta}
            login={walineConfig.login}
            wordLimit={walineConfig.wordLimit}
            pageSize={walineConfig.pageSize}
            imageUploader={walineConfig.imageUploader}
            highlighter={walineConfig.highlighter}
            texRenderer={walineConfig.texRenderer}
            search={walineConfig.search}
            recaptchaV3Key={walineConfig.recaptchaV3Key}
            turnstileKey={walineConfig.turnstileKey}
            reaction={walineConfig.reaction}
            noCopyright={walineConfig.noCopyright}
            commentSorting={walineConfig.commentSorting}
            avatar={walineConfig.avatar}
            avatarCDN={walineConfig.avatarCDN}
            avatarForce={walineConfig.avatarForce}
            uploadImage={walineConfig.uploadImage}
        />
    )}

</MainGridLayout>

<script>
const galleryImages = Array.from(
	document.querySelectorAll(".custom-md img, #post-cover img"),
);
const postContainer = document.getElementById("post-container");
const photoswipeCssUrl = postContainer?.getAttribute("data-photoswipe-style-url");

if (galleryImages.length > 0 && photoswipeCssUrl) {
	let lightboxInitialized = false;

	const ensurePhotoswipeStyles = () => {
		if (document.querySelector(`link[data-photoswipe-style][href="${photoswipeCssUrl}"]`)) {
			return Promise.resolve();
		}

		return new Promise((resolve, reject) => {
			const styleLink = document.createElement("link");
			styleLink.rel = "stylesheet";
			styleLink.href = photoswipeCssUrl;
			styleLink.dataset.photoswipeStyle = "true";
			styleLink.onload = () => resolve(true);
			styleLink.onerror = () => reject(new Error("Failed to load PhotoSwipe styles"));
			document.head.appendChild(styleLink);
		});
	};

	const initLightbox = async () => {
		if (lightboxInitialized) {
			return;
		}
		lightboxInitialized = true;

		await ensurePhotoswipeStyles();
		const [{ default: PhotoSwipeLightbox }, pswpModule] = await Promise.all([
			import("photoswipe/lightbox"),
			import("photoswipe"),
		]);
		const lightbox = new PhotoSwipeLightbox({
			gallery: ".custom-md img, #post-cover img",
			pswpModule: () => Promise.resolve(pswpModule),
			padding: { top: 20, bottom: 20, left: 20, right: 20 },
			wheelToZoom: true,
			arrowPrev: false,
			arrowNext: false,
			imageClickAction: "close",
			tapAction: "close",
			doubleTapAction: "zoom",
		});

		lightbox.addFilter("domItemData", (itemData, element) => {
			if (element instanceof HTMLImageElement) {
				itemData.src = element.src;
				itemData.w = Number(element.naturalWidth || window.innerWidth);
				itemData.h = Number(element.naturalHeight || window.innerHeight);
				itemData.msrc = element.src;
			}

			return itemData;
		});

		lightbox.init();
	};

	const warmLightbox = () => {
		void initLightbox();
	};

	for (const image of galleryImages) {
		image.addEventListener("pointerenter", warmLightbox, {
			once: true,
			passive: true,
		});
		image.addEventListener("touchstart", warmLightbox, {
			once: true,
			passive: true,
		});
	}
}
</script>
