---
import siteBannerOgUrl from "../assets/images/banner.jpg?url";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/scrollbar.css";
import {
	aiSearchConfig,
	analyticsConfig,
	expressiveCodeConfig,
	profileConfig,
	siteConfig,
	walineConfig,
} from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
	PAGE_WIDTH,
} from "../constants/constants";
import { pathsEqual, url } from "../utils/url-utils";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	socialImage?: string;
}

let { title, description, lang, setOGTypeArticle, socialImage } = Astro.props;

const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const configHue = siteConfig.themeColor.hue;

const socialImageUrl =
	socialImage ?? new URL(siteBannerOgUrl, Astro.site ?? Astro.url).href;

const enableBanner = siteConfig.banner.enable;

const pageTitle = title
	? `${title} - ${siteConfig.title}`
	: `${siteConfig.title} - ${siteConfig.subtitle}`;

if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
const gtmId = analyticsConfig.gtmId?.trim();
const shouldLoadGtm =
	import.meta.env.PROD &&
	analyticsConfig.loadStrategy === "interaction" &&
	!!gtmId;
---

<!DOCTYPE html>
<html lang={siteLang} data-theme-mode={DEFAULT_THEME} class="bg-[var(--page-bg)] text-[14px] md:text-[16px]">
	<head>
		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle} />
		<meta name="author" content={profileConfig.name} />

		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description || pageTitle} />
		<meta property="og:image" content={socialImageUrl} />
		{setOGTypeArticle ? (
			<meta property="og:type" content="article" />
		) : (
			<meta property="og:type" content="website" />
		)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description || pageTitle} />
		<meta name="twitter:image" content={socialImageUrl} />

		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="icon"
			href={siteConfig.favicon.startsWith("/") ? url(siteConfig.favicon) : siteConfig.favicon}
		/>

		<script
			is:inline
			define:vars={{
				DEFAULT_THEME,
				LIGHT_MODE,
				DARK_MODE,
				AUTO_MODE,
				BANNER_HEIGHT_EXTEND,
				configHue,
				expressiveCodeTheme: expressiveCodeConfig.theme,
			}}
		>
			function applyRootAppearance() {
				const theme = localStorage.getItem("theme") || DEFAULT_THEME;
				switch (theme) {
					case LIGHT_MODE:
						document.documentElement.classList.remove("dark");
						break;
					case DARK_MODE:
						document.documentElement.classList.add("dark");
						break;
					case AUTO_MODE:
						if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
							document.documentElement.classList.add("dark");
						} else {
							document.documentElement.classList.remove("dark");
						}
						break;
				}

				document.documentElement.dataset.themeMode = theme;
				const storedHue = Number(localStorage.getItem("hue"));
				const hue = Number.isFinite(storedHue) ? storedHue : configHue;
				document.documentElement.style.setProperty("--hue", hue);
				document.documentElement.setAttribute("data-theme", expressiveCodeTheme);

				let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
				offset -= offset % 4;
				document.documentElement.style.setProperty(
					"--banner-height-extend",
					`${offset}px`,
				);
			}

			applyRootAppearance();
		</script>
		<style
			define:vars={{
				configHue,
				"page-width": `${PAGE_WIDTH}rem`,
			}}
		></style>

		<slot name="head"></slot>

		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={siteConfig.title}
			href={new URL("rss.xml", Astro.site ?? Astro.url).href}
		/>
		{shouldLoadGtm && (
			<script is:inline define:vars={{ gtmId }}>
				const injectGtm = () => {
					if (!gtmId || document.querySelector(`script[data-gtm-id="${gtmId}"]`)) {
						return;
					}

					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push({
						"gtm.start": Date.now(),
						event: "gtm.js",
					});

					const warm = document.createElement("link");
					warm.rel = "preconnect";
					warm.href = "https://www.googletagmanager.com";
					document.head.appendChild(warm);

					const script = document.createElement("script");
					script.async = true;
					script.dataset.gtmId = gtmId;
					script.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(gtmId)}`;
					document.head.appendChild(script);
				};

				const interactionEvents = [
					"pointerdown",
					"keydown",
					"touchstart",
					"wheel",
					"scroll",
				];
				let gtmLoaded = false;
				const loadGtmOnInteraction = () => {
					if (gtmLoaded) return;
					gtmLoaded = true;
					for (const eventName of interactionEvents) {
						window.removeEventListener(eventName, loadGtmOnInteraction);
					}
					injectGtm();
				};
				for (const eventName of interactionEvents) {
					window.addEventListener(eventName, loadGtmOnInteraction, {
						passive: true,
					});
				}
			</script>
		)}
		<script is:inline>
			const fontEvents = [
				"pointerdown",
				"keydown",
				"touchstart",
				"wheel",
				"scroll",
			];
			let fontsLoaded = false;
			const loadWebFonts = () => {
				if (fontsLoaded) return;
				fontsLoaded = true;
				for (const eventName of fontEvents) {
					window.removeEventListener(eventName, loadWebFonts);
				}
				for (const [href, crossOrigin] of [
					["https://fonts.googleapis.com", false],
					["https://fonts.gstatic.com", true],
				]) {
					const preconnect = document.createElement("link");
					preconnect.rel = "preconnect";
					preconnect.href = href;
					if (crossOrigin) preconnect.crossOrigin = "anonymous";
					document.head.appendChild(preconnect);
				}
				const link = document.createElement("link");
				link.rel = "stylesheet";
				link.href =
					"https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&family=Noto+Serif+SC:wght@400;700&family=JetBrains+Mono:wght@400;700&display=optional";
				link.dataset.webfonts = "true";
				document.head.appendChild(link);
			};
			for (const eventName of fontEvents) {
				window.addEventListener(eventName, loadWebFonts, { passive: true });
			}
		</script>
	</head>
	<body
		class="min-h-screen"
		class:list={[{ "is-home": isHomePage, "enable-banner": enableBanner }]}
	>
		<slot />
		<!-- AI Search Chat Bubble -->
		{aiSearchConfig.enable && (
			<chat-bubble-snippet
				api-url={aiSearchConfig.apiUrl}
				placeholder="问关于科学 ADV 的任何问题…"
				theme="auto"
				hide-branding
			></chat-bubble-snippet>
		)}

		<script>
			let chatPromise: Promise<unknown> | undefined;
			const ensureChat = () => {
				if (!chatPromise) chatPromise = import("@cloudflare/ai-search-snippet/chat");
				return chatPromise;
			};
			// 慢网络下不做空闲预加载，避免与 LCP 资源抢带宽：只在用户交互时加载
			for (const eventName of ["pointerdown", "keydown"]) {
				window.addEventListener(eventName, () => void ensureChat(), {
					once: true,
					passive: true,
				});
			}
		</script>
	</body>
</html>

<style
	is:global
	define:vars={{
		bannerOffset,
		"banner-height-home": `${BANNER_HEIGHT_HOME}vh`,
		"banner-height": `${BANNER_HEIGHT}vh`,
	}}
>
.enable-banner.is-home #banner-wrapper {
	height: var(--banner-height-home);
	transform: translateY(var(--banner-height-extend));
}

.enable-banner #banner-wrapper {
	height: var(--banner-height-home);
}

#banner-wrapper,
#banner {
	contain: layout paint;
}

.enable-banner.is-home #banner {
	height: var(--banner-height-home);
	transform: translateY(0);
}

.enable-banner #banner {
	height: var(--banner-height-home);
	transform: translateY(var(--bannerOffset));
}

.enable-banner.is-home #main-grid {
	transform: translateY(var(--banner-height-extend));
}

.enable-banner #top-row {
	height: calc(var(--banner-height-home) - 4.5rem);
}

.enable-banner.is-home #sidebar-sticky {
	top: calc(1rem - var(--banner-height-extend));
}

.navbar-hidden {
	opacity: 0;
	transform: translateY(-4rem);
}

.katex-display {
	overflow-x: auto;
	overflow-y: hidden;
	padding-bottom: 0.25rem;
}
</style>

<script
	is:inline
	define:vars={{
		enableBanner,
		BANNER_HEIGHT,
		BANNER_HEIGHT_HOME,
		BANNER_HEIGHT_EXTEND,
		MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
	}}
>
	const bannerEnabled = enableBanner && !!document.getElementById("banner-wrapper");
	const panelConfigs = [
		{
			panelId: "display-setting",
			triggerIds: ["display-setting", "display-settings-switch"],
			toggleId: "display-settings-switch",
		},
		{
			panelId: "nav-menu-panel",
			triggerIds: ["nav-menu-panel", "nav-menu-switch"],
			toggleId: "nav-menu-switch",
		},
		{
			panelId: "search-panel",
			triggerIds: ["search-panel", "search-bar", "search-switch"],
		},
		{
			panelId: "light-dark-panel",
			triggerIds: ["light-dark-panel", "scheme-switch"],
		},
	];

	function clickIsInside(target, ids) {
		return ids.some((id) => {
			const element = document.getElementById(id);
			return element === target || element?.contains(target);
		});
	}

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Node)) return;

		for (const { panelId, triggerIds, toggleId } of panelConfigs) {
			const panel = document.getElementById(panelId);
			if (!panel) continue;
			if (toggleId && clickIsInside(event.target, [toggleId])) {
				panel.classList.toggle("float-panel-closed");
			} else if (!clickIsInside(event.target, triggerIds)) {
				panel.classList.add("float-panel-closed");
			}
		}
		syncPanelTriggerAria();
	});

	function syncPanelTriggerAria() {
		for (const { panelId, triggerIds } of panelConfigs) {
			const panel = document.getElementById(panelId);
			const expanded = !!panel && !panel.classList.contains("float-panel-closed");
			for (const id of triggerIds) {
				const trigger = document.getElementById(id);
				if (trigger instanceof HTMLElement && trigger.hasAttribute("aria-expanded")) {
					trigger.setAttribute("aria-expanded", String(expanded));
				}
			}
		}
	}

	let lastBannerOffset = -1;
	function updateBannerOffset() {
		let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
		offset -= offset % 4;
		if (offset === lastBannerOffset) return;
		lastBannerOffset = offset;
		document.documentElement.style.setProperty(
			"--banner-height-extend",
			`${offset}px`,
		);
	}

	function getBannerHeightPx() {
		if (!bannerEnabled) return 0;
		const bannerHeight =
			document.body.classList.contains("is-home") && window.innerWidth >= 1024
				? BANNER_HEIGHT_HOME
				: BANNER_HEIGHT;
		return window.innerHeight * (bannerHeight / 100);
	}

	const scrollRefs = {
		backToTopBtn: document.getElementById("back-to-top-btn"),
		toc: document.getElementById("toc-wrapper"),
		navbar: document.getElementById("navbar-wrapper"),
	};
	let lastScrollBucket = "";
	function updateScrollState() {
		// 先集中读，再集中写；状态无变化直接返回，避免每帧触发布局
		const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
		const bannerHeightPx = getBannerHeightPx();
		const pastBanner = scrollTop > bannerHeightPx;
		const threshold =
			bannerHeightPx - 72 - MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16 - 16;
		const pastThreshold = scrollTop >= threshold;
		const bucket = `${pastBanner}/${pastThreshold}`;
		if (bucket === lastScrollBucket) return;
		lastScrollBucket = bucket;

		scrollRefs.backToTopBtn?.classList.toggle("hide", !pastBanner);

		if (bannerEnabled && scrollRefs.toc) {
			scrollRefs.toc.classList.toggle("toc-hide", !pastBanner);
		}

		if (!bannerEnabled || !scrollRefs.navbar) {
			return;
		}

		scrollRefs.navbar.classList.toggle("navbar-hidden", pastThreshold);
	}

	let scrollFrame = 0;
	function scheduleScrollUpdate() {
		if (scrollFrame) return;
		scrollFrame = window.requestAnimationFrame(() => {
			scrollFrame = 0;
			updateScrollState();
		});
	}

	window.addEventListener("scroll", scheduleScrollUpdate, { passive: true });
	window.addEventListener(
		"resize",
		() => {
			updateBannerOffset();
			scheduleScrollUpdate();
		},
		{ passive: true },
	);

	function correctAnchorDrift() {
		const rawHash = window.location.hash;
		if (rawHash.length < 2) return;
		let target = null;
		try {
			target = document.getElementById(decodeURIComponent(rawHash.slice(1)));
		} catch {
			return;
		}
		if (!target) return;
		let previousOffset = Number.NaN;
		for (let i = 0; i < 8; i++) {
			const offset = target.getBoundingClientRect().top;
			if (Math.abs(offset) < 2 || offset === previousOffset) break;
			previousOffset = offset;
			window.scrollBy(0, offset);
		}
	}

	if (!window.__anchorDriftBound) {
		window.__anchorDriftBound = true;
		const runWithRetry = () => {
			correctAnchorDrift();
			window.setTimeout(correctAnchorDrift, 250);
		};
		window.addEventListener("hashchange", runWithRetry);
		// 同页锚点点击走 history.pushState，不触发 hashchange，捕获阶段补监听修正。
		document.addEventListener(
			"click",
			(event) => {
				if (
					event.defaultPrevented ||
					event.button !== 0 ||
					event.metaKey ||
					event.ctrlKey ||
					event.shiftKey ||
					event.altKey
				) {
					return;
				}
				const anchor = event
					.composedPath()
					.find(
						(element) =>
							element instanceof HTMLAnchorElement && element.hash.length > 1,
					);
				if (
					!anchor ||
					anchor.origin !== window.location.origin ||
					anchor.pathname !== window.location.pathname
				) {
					return;
				}
				window.requestAnimationFrame(correctAnchorDrift);
				window.setTimeout(correctAnchorDrift, 150);
				window.setTimeout(correctAnchorDrift, 450);
			},
			true,
		);
	}
</script>
