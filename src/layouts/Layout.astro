---
import { ClientRouter } from "astro:transitions";
import roboto400Woff2 from "@fontsource/roboto/files/roboto-latin-400-normal.woff2?url";
import roboto700Woff2 from "@fontsource/roboto/files/roboto-latin-700-normal.woff2?url";
import jetbrainsMonoWoff2 from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import siteBannerOgUrl from "../assets/images/banner.jpg?url";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";
import "../styles/scrollbar.css";
import "../styles/expressive-code.css";
import "../styles/photoswipe.css";
import "../styles/transition.css";
import {
	aiSearchConfig,
	analyticsConfig,
	expressiveCodeConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
	PAGE_WIDTH,
} from "../constants/constants";
import { pathsEqual, url } from "../utils/url-utils";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	socialImage?: string;
}

let { title, description, lang, setOGTypeArticle, socialImage } = Astro.props;

const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const configHue = siteConfig.themeColor.hue;

const socialImageUrl = socialImage ?? new URL(siteBannerOgUrl, Astro.site ?? Astro.url).href;

const enableBanner = siteConfig.banner.enable;

const pageTitle = title
	? `${title} - ${siteConfig.title}`
	: `${siteConfig.title} - ${siteConfig.subtitle}`;

if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
const gtmId = analyticsConfig.gtmId?.trim();
const shouldLoadGtm =
	import.meta.env.PROD && analyticsConfig.loadStrategy === "idle" && !!gtmId;
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]">
	<head>
		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle} />
		<meta name="author" content={profileConfig.name} />

		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description || pageTitle} />
		<meta property="og:image" content={socialImageUrl} />
		{setOGTypeArticle ? (
			<meta property="og:type" content="article" />
		) : (
			<meta property="og:type" content="website" />
		)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description || pageTitle} />
		<meta name="twitter:image" content={socialImageUrl} />

		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="icon"
			href={siteConfig.favicon.startsWith("/") ? url(siteConfig.favicon) : siteConfig.favicon}
		/>

		<script
			is:inline
			define:vars={{
				DEFAULT_THEME,
				LIGHT_MODE,
				DARK_MODE,
				AUTO_MODE,
				BANNER_HEIGHT_EXTEND,
				configHue,
				expressiveCodeTheme: expressiveCodeConfig.theme,
			}}
		>
			function applyRootAppearance() {
				const theme = localStorage.getItem("theme") || DEFAULT_THEME;
				switch (theme) {
					case LIGHT_MODE:
						document.documentElement.classList.remove("dark");
						break;
					case DARK_MODE:
						document.documentElement.classList.add("dark");
						break;
					case AUTO_MODE:
						if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
							document.documentElement.classList.add("dark");
						} else {
							document.documentElement.classList.remove("dark");
						}
						break;
				}

				const storedHue = Number(localStorage.getItem("hue"));
				const hue = Number.isFinite(storedHue) ? storedHue : configHue;
				document.documentElement.style.setProperty("--hue", hue);
				document.documentElement.setAttribute("data-theme", expressiveCodeTheme);

				let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
				offset -= offset % 4;
				document.documentElement.style.setProperty(
					"--banner-height-extend",
					`${offset}px`,
				);
			}

			applyRootAppearance();
			document.addEventListener("astro:after-swap", applyRootAppearance);
		</script>
		<style
			define:vars={{
				configHue,
				"page-width": `${PAGE_WIDTH}rem`,
			}}
		></style>

		<slot name="head"></slot>

		<link
			rel="alternate"
			type="application/rss+xml"
			title={profileConfig.name}
			href={`${Astro.site}rss.xml`}
		/>

		{shouldLoadGtm && (
			<script is:inline define:vars={{ gtmId }}>
				const injectGtm = () => {
					if (!gtmId || document.querySelector(`script[data-gtm-id="${gtmId}"]`)) {
						return;
					}

					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push({
						"gtm.start": Date.now(),
						event: "gtm.js",
					});

					const script = document.createElement("script");
					script.async = true;
					script.dataset.gtmId = gtmId;
					script.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(gtmId)}`;
					document.head.appendChild(script);
				};

				const scheduleGtm = () => {
					if (typeof window.requestIdleCallback === "function") {
						window.requestIdleCallback(injectGtm, { timeout: 8000 });
						return;
					}
					window.setTimeout(injectGtm, 4000);
				};

				if (document.readyState === "complete") {
					scheduleGtm();
				} else {
					window.addEventListener("load", scheduleGtm, { once: true });
				}
			</script>
		)}
		<script
			is:inline
			define:vars={{
				sansFontFaces: [
					{ family: "Roboto", source: roboto400Woff2, descriptors: { weight: "400", style: "normal" } },
					{ family: "Roboto", source: roboto700Woff2, descriptors: { weight: "700", style: "normal" } },
				],
				monoFontFace: {
					family: "JetBrains Mono Variable",
					source: jetbrainsMonoWoff2,
					descriptors: { weight: "100 800", style: "normal" },
				},
			}}
		>
			const loadedFontFamilies = new Set();

			async function loadFontFace(fontConfig) {
				if (!fontConfig?.source || loadedFontFamilies.has(fontConfig.family)) {
					return;
				}

				try {
					const fontFace = new FontFace(
						fontConfig.family,
						`url(${fontConfig.source}) format("woff2")`,
						fontConfig.descriptors,
					);
					await fontFace.load();
					document.fonts.add(fontFace);
					loadedFontFamilies.add(fontConfig.family);
				} catch (error) {
					console.error(`Failed to load font ${fontConfig.family}:`, error);
				}
			}

			const loadLazyFonts = async () => {
				if (!("fonts" in document)) {
					return;
				}

				for (const fontConfig of sansFontFaces) {
					await loadFontFace(fontConfig);
				}

				if (document.querySelector("pre, code, .expressive-code, .custom-md")) {
					await loadFontFace(monoFontFace);
				}
			};

			let fontLoadScheduled = false;
			const scheduleLazyFonts = () => {
				if (fontLoadScheduled) {
					return;
				}
				fontLoadScheduled = true;
				window.setTimeout(() => {
					void loadLazyFonts();
				}, 1200);
			};

			for (const eventName of ["pointerdown", "keydown", "touchstart"]) {
				window.addEventListener(eventName, scheduleLazyFonts, {
					once: true,
					passive: eventName !== "keydown",
				});
			}

			window.addEventListener(
				"load",
				() => {
					window.setTimeout(scheduleLazyFonts, 6000);
				},
				{ once: true },
			);

			document.addEventListener("astro:after-swap", () => {
				fontLoadScheduled = false;
				scheduleLazyFonts();
			});
		</script>
	</head>
	<body
		class="min-h-screen transition"
		class:list={[{ "is-home": isHomePage, "enable-banner": enableBanner }]}
	>
		<ClientRouter />
		<slot />
		<!-- AI Search Chat Bubble -->
		{aiSearchConfig.enable && (
			<chat-bubble-snippet
				api-url={aiSearchConfig.apiUrl}
				placeholder="问关于科学 ADV 的任何问题…"
				theme="auto"
				hide-branding
			></chat-bubble-snippet>
		)}

		<script>
			let chatPromise: Promise<unknown> | undefined;
			const ensureChat = () => {
				if (!chatPromise) chatPromise = import("@cloudflare/ai-search-snippet/chat");
				return chatPromise;
			};
			if (typeof window.requestIdleCallback === "function") {
				window.requestIdleCallback(() => void ensureChat(), { timeout: 6000 });
			} else {
				window.setTimeout(() => void ensureChat(), 4000);
			}
			for (const eventName of ["pointerdown", "keydown"]) {
				window.addEventListener(eventName, () => void ensureChat(), {
					once: true,
					passive: true,
				});
			}
		</script>
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style
	is:global
	define:vars={{
		bannerOffset,
		"banner-height-home": `${BANNER_HEIGHT_HOME}vh`,
		"banner-height": `${BANNER_HEIGHT}vh`,
	}}
>
.enable-banner.is-home #banner-wrapper {
	height: var(--banner-height-home);
	transform: translateY(var(--banner-height-extend));
}

.enable-banner #banner-wrapper {
	height: var(--banner-height-home);
}

.enable-banner.is-home #banner {
	height: var(--banner-height-home);
	transform: translateY(0);
}

.enable-banner #banner {
	height: var(--banner-height-home);
	transform: translateY(var(--bannerOffset));
}

.enable-banner.is-home #main-grid {
	transform: translateY(var(--banner-height-extend));
}

.enable-banner #top-row {
	height: calc(var(--banner-height-home) - 4.5rem);
	transition: all 300ms;
}

.enable-banner.is-home #sidebar-sticky {
	top: calc(1rem - var(--banner-height-extend));
}

.navbar-hidden {
	opacity: 0;
	transform: translateY(-4rem);
}

.katex-display {
	overflow-x: auto;
	overflow-y: hidden;
	padding-bottom: 0.25rem;
}
</style>

<script
	is:inline
	define:vars={{
		enableBanner,
		BANNER_HEIGHT,
		BANNER_HEIGHT_HOME,
		BANNER_HEIGHT_EXTEND,
		MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
	}}
>
	const bannerEnabled = enableBanner && !!document.getElementById("banner-wrapper");
	const panelConfigs = [
		{
			panelId: "display-setting",
			triggerIds: ["display-setting", "display-settings-switch"],
		},
		{
			panelId: "nav-menu-panel",
			triggerIds: ["nav-menu-panel", "nav-menu-switch"],
		},
		{
			panelId: "search-panel",
			triggerIds: ["search-panel", "search-bar", "search-switch"],
		},
		{
			panelId: "light-dark-panel",
			triggerIds: ["light-dark-panel", "scheme-switch"],
		},
	];

	function clickIsInside(target, ids) {
		return ids.some((id) => {
			const element = document.getElementById(id);
			return element === target || element?.contains(target);
		});
	}

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Node)) return;

		for (const { panelId, triggerIds } of panelConfigs) {
			const panel = document.getElementById(panelId);
			if (!panel || clickIsInside(event.target, triggerIds)) {
				continue;
			}
			panel.classList.add("float-panel-closed");
		}
	});

	function closeFloatPanels() {
		for (const { panelId } of panelConfigs) {
			document.getElementById(panelId)?.classList.add("float-panel-closed");
		}
	}

	function updateBannerOffset() {
		let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
		offset -= offset % 4;
		document.documentElement.style.setProperty(
			"--banner-height-extend",
			`${offset}px`,
		);
	}

	function getBannerHeightPx() {
		if (!bannerEnabled) return 0;
		const bannerHeight =
			document.body.classList.contains("is-home") && window.innerWidth >= 1024
				? BANNER_HEIGHT_HOME
				: BANNER_HEIGHT;
		return window.innerHeight * (bannerHeight / 100);
	}

	function setHomeState(pathname) {
		const nextPathname = new URL(pathname, window.location.origin).pathname;
		document.body.classList.toggle("is-home", nextPathname === "/");
	}

	function showBanner() {
		if (!bannerEnabled) {
			return;
		}

		const banner = document.getElementById("banner");
		banner?.classList.remove("opacity-0", "scale-105");
	}

	function updateScrollState() {
		const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
		const bannerHeightPx = getBannerHeightPx();
		const backToTopBtn = document.getElementById("back-to-top-btn");
		const toc = document.getElementById("toc-wrapper");
		const navbar = document.getElementById("navbar-wrapper");

		backToTopBtn?.classList.toggle("hide", scrollTop <= bannerHeightPx);

		if (bannerEnabled && toc) {
			toc.classList.toggle("toc-hide", scrollTop <= bannerHeightPx);
		}

		if (!bannerEnabled || !navbar) {
			return;
		}

		const threshold =
			bannerHeightPx - 72 - MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16 - 16;
		navbar.classList.toggle("navbar-hidden", scrollTop >= threshold);
	}

	let scrollFrame = 0;
	function scheduleScrollUpdate() {
		if (scrollFrame) return;
		scrollFrame = window.requestAnimationFrame(() => {
			scrollFrame = 0;
			updateScrollState();
		});
	}

	function markTocTransitionState(isNavigating) {
		const toc = document.getElementById("toc-wrapper");
		if (!toc) {
			return;
		}
		toc.classList.toggle("toc-not-ready", isNavigating);
	}

	function setPageHeightExtension(visible) {
		const heightExtend = document.getElementById("page-height-extend");
		if (!heightExtend) {
			return;
		}
		heightExtend.classList.toggle("hidden", !visible);
	}

	function preparePageTransition(pathname) {
		document.documentElement.style.setProperty("--content-delay", "0ms");
		closeFloatPanels();
		setHomeState(pathname);
		markTocTransitionState(true);
		setPageHeightExtension(true);
		scheduleScrollUpdate();
	}

	function completePageTransition() {
		showBanner();
		scheduleScrollUpdate();
		window.setTimeout(() => {
			markTocTransitionState(false);
			setPageHeightExtension(false);
		}, 200);
	}

	updateBannerOffset();
	showBanner();
	updateScrollState();

	window.addEventListener("scroll", scheduleScrollUpdate, { passive: true });
	window.addEventListener(
		"resize",
		() => {
			updateBannerOffset();
			scheduleScrollUpdate();
		},
		{ passive: true },
	);

	document.addEventListener("astro:before-preparation", (event) => {
		preparePageTransition(event.to?.href || window.location.href);
	});

	document.addEventListener("astro:page-load", () => {
		setHomeState(window.location.href);
		completePageTransition();
	});
</script>
