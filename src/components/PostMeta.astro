---
import { Icon } from "astro-icon/components";
import { authors } from "../authors";
import { profileConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";
import Avatar from "./misc/Avatar.astro";

interface Props {
	class: string;
	date: Date;
	updated?: Date;
	tags: string[];
	categories: string[];
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
	authorId?: string;
}
const {
	date,
	updated,
	tags,
	categories,
	hideTagsForMobile = false,
	hideUpdateDate = false,
	authorId,
} = Astro.props;
const className = Astro.props.class;
const author =
	authorId && authors[authorId]
		? authors[authorId]
		: {
				name: profileConfig.name,
				avatar: profileConfig.avatar,
				url: Astro.site?.toString() || "",
			};
---

<div class:list={["flex flex-wrap text-neutral-500 dark:text-neutral-400 items-center gap-4 gap-x-4 gap-y-2", className]}>
    <!-- author -->
    <div class="flex items-center">
        <div class="meta-icon">
            {author.avatar ? (
                <Avatar src={author.avatar} alt={author.name} class="w-8 h-8 object-cover rounded " size={64} />
            ) : (
                <Icon name="material-symbols:person-outline-rounded" class="text-xl"></Icon>
            )}
        </div>
        {author.url ? (
            <a href={author.url} target="_blank" class="link-lg transition text-50 text-sm font-medium hover:text-[var(--primary)] dark:hover:text-[var(--primary)]">{author.name}</a>
        ) : (
            <span class="text-50 text-sm font-medium">{author.name}</span>
        )}
    </div>

    <!-- publish date -->
    <div class="flex items-center">
        <div class="meta-icon"
        >
            <Icon name="material-symbols:calendar-today-outline-rounded" class="text-xl"></Icon>
        </div>
        <span class="text-50 text-sm font-medium">{formatDateToYYYYMMDD(date)}</span>
    </div>

    <!-- update date -->
    {!hideUpdateDate && updated && updated.getTime() !== date.getTime() && (
        <div class="flex items-center">
            <div class="meta-icon"
            >
                <Icon name="material-symbols:edit-calendar-outline-rounded" class="text-xl"></Icon>
            </div>
            <span class="text-50 text-sm font-medium">{formatDateToYYYYMMDD(updated)}</span>
        </div>
    )}

    <!-- categories -->
    <div class="flex items-center">
        <div class="meta-icon"
        >
            <Icon name="material-symbols:book-2-outline-rounded" class="text-xl"></Icon>
        </div>
        <div class="flex flex-row flex-nowrap items-center">
            {categories && categories.length > 0 ? (
                categories.map((cat, i) => (
                    <>
                        {i > 0 && <div class="mx-1.5 text-[var(--meta-divider)] text-sm">/</div>}
                        <a href={getCategoryUrl(cat)} aria-label={`View all posts in the ${cat} categories`}
                           class="link-lg transition text-50 text-sm font-medium
                                        hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap">
                            {cat}
                        </a>
                    </>
                ))
            ) : (
                <a href={getCategoryUrl(null)} aria-label="View all uncategorized posts"
                   class="link-lg transition text-50 text-sm font-medium
                                hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap">
                    {i18n(I18nKey.uncategorized)}
                </a>
            )}
        </div>
    </div>

    <!-- tags -->
    <div class:list={["items-center", {"flex": !hideTagsForMobile, "hidden md:flex": hideTagsForMobile}]}>
        <div class="meta-icon"
        >
            <Icon name="material-symbols:tag-rounded" class="text-xl"></Icon>
        </div>
        <div class="flex flex-row flex-nowrap items-center">
            {(tags && tags.length > 0) && tags.map((tag, i) => (
                <div class:list={[{"hidden": i == 0}, "mx-1.5 text-[var(--meta-divider)] text-sm"]}>/</div>
                <a href={getTagUrl(tag)} aria-label={`View all posts with the ${tag.trim()} tag`}
                   class="link-lg transition text-50 text-sm font-medium
                                hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap">
                    {tag.trim()}
                </a>
            ))}
            {!(tags && tags.length > 0) && <div class="transition text-50 text-sm font-medium">{i18n(I18nKey.noTags)}</div>}
        </div>
    </div>
</div>