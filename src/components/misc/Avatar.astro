---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { resolveLocalImage } from "../../utils/image-utils";
import { url } from "../../utils/url-utils";

interface Props {
	src: string;
	alt: string;
	class?: string;
	size?: number;
}

const { src, alt, size = 64 } = Astro.props;
const className = Astro.props.class ?? "w-6 h-6 object-cover";

const isBundledAsset = src.startsWith("/assets/");
const isLocal =
	isBundledAsset ||
	!(
		src.startsWith("/") ||
		src.startsWith("http") ||
		src.startsWith("https") ||
		src.startsWith("data:")
	);
const isPublic = src.startsWith("/") && !src.startsWith("/assets/");

let img: ImageMetadata | undefined;
if (isLocal) {
	img = await resolveLocalImage(src);
}

const localFormats = img
	? Array.from(
			new Set([
				"avif",
				"webp",
				img.format === "png" ? "png" : img.format === "webp" ? "webp" : "jpg",
			]),
		)
	: undefined;

const responsiveWidths = Array.from(new Set([size, size * 2])).sort(
	(a, b) => a - b,
);

const imageClass = className;
---
{isLocal && img && localFormats && (
	<Picture
		src={img}
		alt={alt}
		class={imageClass}
		formats={localFormats}
		widths={responsiveWidths}
		sizes={`${size}px`}
		loading="lazy"
		decoding="async"
		fetchpriority="low"
	/>
)}
{isLocal && !img && (
	<div
		aria-hidden="true"
		class={imageClass}
		title={`Missing avatar: ${src}`}
	></div>
)}
{!isLocal && (
	<img
		src={isPublic ? url(src) : src}
		alt={alt}
		class={imageClass}
		width={size}
		height={size}
		loading="lazy"
		decoding="async"
		fetchpriority="low"
	/>
)}
