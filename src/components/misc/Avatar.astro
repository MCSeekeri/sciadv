---
import { Picture } from "astro:assets";
import path from "node:path";
import type { ImageMetadata } from "astro";
import { url } from "../../utils/url-utils";

interface Props {
	src: string;
	alt: string;
	class?: string;
	size?: number;
}

const { src, alt, size = 64 } = Astro.props;
const className = Astro.props.class ?? "w-6 h-6 object-cover";

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

let img: ImageMetadata | undefined;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	const normalizedPath = path
		.normalize(path.join("../../", src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Avatar image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const localFormats = img
	? Array.from(new Set(["avif", "webp", img.format === "png" ? "png" : img.format === "webp" ? "webp" : "jpg"]))
	: undefined;

const responsiveWidths = Array.from(new Set([size, size * 2])).sort((a, b) => a - b);

const imageClass = className;
---
{isLocal && img && localFormats && (
	<Picture
		src={img}
		alt={alt}
		class={imageClass}
		formats={localFormats}
		widths={responsiveWidths}
		sizes={`${size}px`}
		loading="lazy"
		decoding="async"
		fetchpriority="low"
	/>
)}
{isLocal && !img && (
	<div
		aria-hidden="true"
		class={imageClass}
		title={`Missing avatar: ${src}`}
	></div>
)}
{!isLocal && (
	<img
		src={isPublic ? url(src) : src}
		alt={alt}
		class={imageClass}
		width={size}
		height={size}
		loading="lazy"
		decoding="async"
		fetchpriority="low"
	/>
)}
