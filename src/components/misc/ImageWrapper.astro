---
import { getImage, Picture } from "astro:assets";
import { resolveLocalImage } from "../../utils/image-utils";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
	decoding?: "async" | "auto" | "sync";
	fetchpriority?: "high" | "low" | "auto";
	sizes?: string;
	widths?: number[];
	priority?: boolean;
	singleSourceWidth?: number;
	singleSourceFormat?: "avif" | "webp" | "png" | "jpg" | "jpeg";
}

import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading,
	decoding = "async",
	fetchpriority,
	sizes,
	widths,
	priority = false,
	singleSourceWidth,
	singleSourceFormat,
} = Astro.props;
const className = Astro.props.class;

const isBundledAsset = src.startsWith("/assets/");
const isLocal =
	isBundledAsset ||
	!(
		src.startsWith("/") ||
		src.startsWith("http") ||
		src.startsWith("https") ||
		src.startsWith("data:")
	);
const isPublic = src.startsWith("/") && !src.startsWith("/assets/");

let img: ImageMetadata | undefined;
if (isLocal) {
	img = await resolveLocalImage(src, basePath);
}

const isPngSource =
	isLocal && img
		? img.src.toLowerCase().endsWith(".png")
		: src.toLowerCase().endsWith(".png");
const fallbackFormat = isPngSource ? "png" : "jpg";
const resolvedWidths = widths ?? [400, 800, 1200];
const resolvedSizes = sizes ?? "(max-width: 768px) 100vw, 800px";

const singleSourceImage =
	isLocal && img && singleSourceWidth
		? await getImage({
				src: img,
				width: singleSourceWidth,
				format: singleSourceFormat ?? fallbackFormat,
			})
		: undefined;

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
const resolvedLoading = priority ? "eager" : loading || "lazy";
const resolvedFetchPriority = priority ? "high" : fetchpriority || "auto";
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {singleSourceImage && <img
        src={singleSourceImage.src}
        alt={alt || ""}
        class={imageClass}
        style={imageStyle}
        width={singleSourceImage.attributes.width}
        height={singleSourceImage.attributes.height}
        loading={resolvedLoading}
        decoding={decoding}
        fetchpriority={resolvedFetchPriority}
    />}
    {!singleSourceImage && isLocal && img && <Picture
        src={img}
        alt={alt || ""}
        formats={['avif', 'webp', 'png']}
        fallbackFormat={fallbackFormat}
        class={imageClass}
        style={imageStyle}
        loading={resolvedLoading}
        decoding={decoding}
        fetchpriority={resolvedFetchPriority}
        sizes={resolvedSizes}
        widths={resolvedWidths}
    />}
    {!isLocal && <img
        src={isPublic ? url(src) : src}
        alt={alt || ""}
        class={imageClass}
        style={imageStyle}
        loading={resolvedLoading}
        decoding={decoding}
        fetchpriority={resolvedFetchPriority}
    />}
</div>
