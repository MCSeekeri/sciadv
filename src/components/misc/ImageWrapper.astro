---
import path from "node:path";
import { Picture, getImage } from "astro:assets";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
	decoding?: "async" | "auto" | "sync";
	fetchpriority?: "high" | "low" | "auto";
	sizes?: string;
	widths?: number[];
	priority?: boolean;
	singleSourceWidth?: number;
	singleSourceFormat?: "avif" | "webp" | "png" | "jpg" | "jpeg";
}

import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading,
	decoding = "async",
	fetchpriority,
	sizes,
	widths,
	priority = false,
	singleSourceWidth,
	singleSourceFormat = "webp",
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img: ImageMetadata | undefined;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	const normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const singleSourceImage =
	isLocal && img && singleSourceWidth
		? await getImage({
				src: img,
				width: singleSourceWidth,
				format: singleSourceFormat,
			})
		: undefined;

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
const resolvedLoading = priority ? "eager" : loading || "lazy";
const resolvedFetchPriority = priority ? "high" : fetchpriority || "auto";
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {singleSourceImage && <img
        src={singleSourceImage.src}
        alt={alt || ""}
        class={imageClass}
        style={imageStyle}
        width={singleSourceImage.attributes.width}
        height={singleSourceImage.attributes.height}
        loading={resolvedLoading}
        decoding={decoding}
        fetchpriority={resolvedFetchPriority}
    />}
    {!singleSourceImage && isLocal && img && <Picture
        src={img}
        alt={alt || ""}
        formats={['avif', 'webp', 'jpg']}
        class={imageClass}
        style={imageStyle}
        loading={resolvedLoading}
        decoding={decoding}
        fetchpriority={resolvedFetchPriority}
        sizes={sizes}
        widths={widths}
    />}
    {!isLocal && <img
        src={isPublic ? url(src) : src}
        alt={alt || ""}
        class={imageClass}
        style={imageStyle}
        loading={resolvedLoading}
        decoding={decoding}
        fetchpriority={resolvedFetchPriority}
    />}
</div>
