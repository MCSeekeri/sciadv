---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import type { PostForList } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Props {
	sortedPosts: PostForList[];
}

const { sortedPosts } = Astro.props as Props;

type Group = {
	year: number;
	posts: PostForList[];
};

const groupedPosts = sortedPosts.reduce((groups, post) => {
	const year = new Date(post.data.date).getFullYear();
	const existingGroup = groups.find((group) => group.year === year);
	if (existingGroup) {
		existingGroup.posts.push(post);
		return groups;
	}

	groups.push({ year, posts: [post] });
	return groups;
}, [] as Group[]);

const formatDate = (date: Date) => {
	const month = (date.getMonth() + 1).toString().padStart(2, "0");
	const day = date.getDate().toString().padStart(2, "0");
	return `${month}-${day}`;
};

const formatTag = (tagList: string[]) => tagList.map((tag) => `#${tag}`).join(" ");
const emptyStateText = "No posts match the current filters.";
---

<div class="card-base px-8 py-6">
	<p id="archive-empty-state" class="hidden text-50 text-sm">{emptyStateText}</p>
	{groupedPosts.map((group) => (
		<section data-archive-group={group.year}>
			<div class="flex flex-row w-full items-center h-[3.75rem]">
				<div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">
					{group.year}
				</div>
				<div class="w-[15%] md:w-[10%]">
					<div
						class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto
                  -outline-offset-[2px] z-50 outline-3"
					></div>
				</div>
				<div class="w-[70%] md:w-[80%] transition text-left text-50">
					<span data-archive-count>{group.posts.length}</span>
					{" "}
					{i18n(group.posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}
				</div>
			</div>

			{group.posts.map((post) => (
				<a
					href={getPostUrlBySlug(post.slug)}
					aria-label={post.data.title}
					class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
					data-archive-post
					data-tags={JSON.stringify(post.data.tags)}
					data-categories={JSON.stringify(post.data.categories)}
				>
					<div class="flex flex-row justify-start items-center h-full">
						<div class="w-[15%] md:w-[10%] transition text-sm text-right text-50">
							{formatDate(post.data.date)}
						</div>

						<div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
							<div
								class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5
                       bg-[oklch(0.5_0.05_var(--hue))] group-hover:bg-[var(--primary)]
                       outline outline-4 z-50
                       outline-[var(--card-bg)]
                       group-hover:outline-[var(--btn-plain-bg-hover)]
                       group-active:outline-[var(--btn-plain-bg-active)]"
							></div>
						</div>

						<div
							class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold
                     group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)]
                     text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden"
						>
							{post.data.title}
						</div>

						<div
							class="hidden md:block md:w-[15%] text-left text-sm transition
                     whitespace-nowrap overflow-ellipsis overflow-hidden text-30"
						>
							{formatTag(post.data.tags)}
						</div>
					</div>
				</a>
			))}
		</section>
	))}
</div>

<script>
	function updateArchivePanel() {
		const archiveGroups = Array.from(
			document.querySelectorAll<HTMLElement>("[data-archive-group]"),
		);
		const emptyState = document.getElementById("archive-empty-state");
		const params = new URLSearchParams(window.location.search);
		const selectedTags = params.getAll("tag");
		const selectedCategories = params.getAll("categories");
		const uncategorizedOnly = params.has("uncategorized");

		function parseList(value: string | null): string[] {
			try {
				return JSON.parse(value || "[]");
			} catch {
				return [];
			}
		}

		function matchesFilters(post: HTMLElement) {
			const tags = parseList(post.getAttribute("data-tags"));
			const categories = parseList(post.getAttribute("data-categories"));

			if (
				selectedTags.length > 0 &&
				!tags.some((tag: string) => selectedTags.includes(tag))
			) {
				return false;
			}

			if (
				selectedCategories.length > 0 &&
				!categories.some((category: string) =>
					selectedCategories.includes(category),
				)
			) {
				return false;
			}

			if (uncategorizedOnly && categories.length > 0) {
				return false;
			}

			return true;
		}

		let visiblePostCount = 0;

		for (const group of archiveGroups) {
			const posts = Array.from(
				group.querySelectorAll<HTMLElement>("[data-archive-post]"),
			);
			let visibleCount = 0;

			for (const post of posts) {
				const visible = matchesFilters(post);
				post.hidden = !visible;
				if (visible) {
					visibleCount += 1;
					visiblePostCount += 1;
				}
			}

			const countElement = group.querySelector("[data-archive-count]");
			if (countElement) {
				countElement.textContent = String(visibleCount);
			}
			group.hidden = visibleCount === 0;
		}

		if (emptyState) {
			emptyState.classList.toggle("hidden", visiblePostCount > 0);
		}
	}

	updateArchivePanel();
	document.addEventListener("astro:page-load", updateArchivePanel);
</script>
