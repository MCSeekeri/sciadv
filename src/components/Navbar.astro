---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.astro";
import Search from "./Search.astro";
import DisplaySettings from "./widget/DisplaySettings.astro";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
                {siteConfig.title}
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => (
                <div class="relative group" data-nav-item>
                    {l.url ? (
                        <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                           class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95 flex items-center"
                        >
                            <div class="flex items-center">
                                {l.name}
                                {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                                {l.sublinks && <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.25rem] text-[var(--primary)] ml-1 transition-transform duration-200 group-hover:-rotate-180"></Icon>}
                            </div>
                        </a>
                    ) : (
                        <button type="button" data-nav-trigger aria-expanded="false"
                           class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95 flex items-center cursor-default"
                        >
                            <div class="flex items-center">
                                {l.name}
                                {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                                {l.sublinks && <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.25rem] text-[var(--primary)] ml-1 transition-transform duration-200 group-hover:-rotate-180 group-data-[open=true]:-rotate-180"></Icon>}
                            </div>
                        </button>
                    )}
                    {l.sublinks && (
                        <div data-nav-submenu class="absolute top-11 pt-2 left-0 w-max hidden group-hover:block group-focus-within:block transition z-50 animate-fade-in-up-fast">
                            <div class="card-base !p-2 flex flex-col gap-1 w-full rounded-xl shadow-xl">
                                {l.sublinks.map((sub) => (
                                    <a aria-label={sub.name} href={sub.external ? sub.url : url(sub.url!)} target={sub.external ? "_blank" : null}
                                       class="btn-plain scale-animation rounded-lg h-10 font-bold px-3 active:scale-95 text-sm w-full text-nowrap flex items-center"
                                    >
                                        <div class="flex items-center">
                                            {sub.name}
                                            {sub.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.75rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            ))}
        </div>
        <div class="flex">
            <Search></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" aria-expanded="false" aria-controls="display-setting" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" aria-expanded="false" aria-controls="nav-menu-panel" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings></DisplaySettings>
    </div>
</div>

<script is:inline>
function setNavSubmenuOpen(item, open) {
    const trigger = item.querySelector("[data-nav-trigger]");
    const submenu = item.querySelector("[data-nav-submenu]");
    if (!(submenu instanceof HTMLElement)) return;
    submenu.classList.toggle("hidden", !open);
    if (trigger instanceof HTMLElement) {
        trigger.setAttribute("aria-expanded", String(open));
    }
    if (open) {
        item.dataset.open = "true";
    } else {
        delete item.dataset.open;
    }
}

function setupNavSubmenus() {
    const canHover = window.matchMedia("(hover: hover)").matches;

    for (const item of document.querySelectorAll("[data-nav-item]")) {
        if (!(item instanceof HTMLElement) || item.dataset.bound === "true") continue;
        const trigger = item.querySelector("[data-nav-trigger]");
        const submenu = item.querySelector("[data-nav-submenu]");
        if (!(trigger instanceof HTMLElement) || !(submenu instanceof HTMLElement)) continue;
        item.dataset.bound = "true";

        trigger.addEventListener("click", (event) => {
            if (event.detail === 0 || !canHover) {
                setNavSubmenuOpen(item, true);
                return;
            }
            setNavSubmenuOpen(item, item.dataset.open !== "true");
        });
        trigger.addEventListener("focus", () => setNavSubmenuOpen(item, true));
        item.addEventListener("focusout", (event) => {
            const next = event.relatedTarget;
            if (next instanceof Node && item.contains(next)) return;
            setNavSubmenuOpen(item, false);
        });
        item.addEventListener("keydown", (event) => {
            if (event.key === "Escape") setNavSubmenuOpen(item, false);
        });
    }

    if (document.documentElement.dataset.navSubmenuBound === "true") return;
    document.documentElement.dataset.navSubmenuBound = "true";

    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Node)) return;
        for (const item of document.querySelectorAll("[data-nav-item][data-open]")) {
            if (!item.contains(event.target)) setNavSubmenuOpen(item, false);
        }
    });
    document.addEventListener("astro:page-load", () => {
        for (const item of document.querySelectorAll("[data-nav-item][data-open]")) {
            setNavSubmenuOpen(item, false);
        }
    });
}

setupNavSubmenus();
</script>
