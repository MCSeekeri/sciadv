---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import searchScriptUrl from "../scripts/search.js?url";
import { url } from "../utils/url-utils";

const searchLabel = i18n(I18nKey.search);
const loadingLabel = "Loading search...";
const emptyLabel = "No results found.";
const unavailableLabel = import.meta.env.PROD
	? "Search is unavailable right now."
	: "Search works in the production build.";
---

<div
	id="search-root"
	class="contents"
	data-pagefind-script-url={url("/pagefind/pagefind.js")}
	data-loading-label={loadingLabel}
	data-empty-label={emptyLabel}
	data-unavailable-label={unavailableLabel}
	data-is-prod={import.meta.env.PROD ? "true" : "false"}
>
	<!-- search bar for desktop view -->
	<div
		id="search-bar"
		class="hidden lg:flex transition-all items-center h-11 mr-2 rounded-lg
      bg-black/[0.04] hover:bg-black/[0.06] focus-within:bg-black/[0.06]
      dark:bg-white/5 dark:hover:bg-white/10 dark:focus-within:bg-white/10
"
	>
		<Icon
			name="material-symbols:search"
			class="absolute text-[1.25rem] pointer-events-none ml-3 transition my-auto text-black/30 dark:text-white/30"
		/>
		<input
			id="search-input-desktop"
			placeholder={searchLabel}
			class="transition-all pl-10 text-sm bg-transparent outline-0
         h-full w-40 active:w-60 focus:w-60 text-black/50 dark:text-white/50"
		/>
	</div>

	<!-- toggle btn for phone/tablet view -->
	<button
		aria-label="Search Panel"
		id="search-switch"
		class="btn-plain scale-animation lg:!hidden rounded-lg w-11 h-11 active:scale-90"
	>
		<Icon name="material-symbols:search" class="text-[1.25rem]" />
	</button>

	<!-- search panel -->
	<div
		id="search-panel"
		class="float-panel float-panel-closed search-panel absolute md:w-[30rem]
top-20 left-4 md:left-[unset] right-4 shadow-2xl rounded-2xl p-2"
	>
		<!-- search bar inside panel for phone/tablet -->
		<div
			id="search-bar-inside"
			class="flex relative lg:hidden transition-all items-center h-11 rounded-xl
      bg-black/[0.04] hover:bg-black/[0.06] focus-within:bg-black/[0.06]
      dark:bg-white/5 dark:hover:bg-white/10 dark:focus-within:bg-white/10
  "
		>
			<Icon
				name="material-symbols:search"
				class="absolute text-[1.25rem] pointer-events-none ml-3 transition my-auto text-black/30 dark:text-white/30"
			/>
			<input
				id="search-input-mobile"
				placeholder={searchLabel}
				class="pl-10 absolute inset-0 text-sm bg-transparent outline-0
               focus:w-60 text-black/50 dark:text-white/50"
			/>
		</div>

		<div id="search-status" class="transition mt-2 px-3 py-2 text-sm text-50 hidden"></div>
		<div id="search-results"></div>
	</div>
</div>

<style>
	input:focus {
		outline: 0;
	}

	.search-panel {
		max-height: calc(100vh - 100px);
		overflow-y: auto;
	}
</style>

<script is:inline type="module" define:vars={{ searchScriptUrl }}>
	if (!window.__searchScriptPromise) {
		window.__searchScriptPromise = undefined;
	}

	const ensureSearchScript = async () => {
		if (!window.__searchScriptPromise) {
			window.__searchScriptPromise = import(searchScriptUrl);
		}
		await window.__searchScriptPromise;
	};

	const desktopInput = document.getElementById("search-input-desktop");
	const mobileInput = document.getElementById("search-input-mobile");
	const searchSwitch = document.getElementById("search-switch");
	const desktopBar = document.getElementById("search-bar");
	const mobileBar = document.getElementById("search-bar-inside");

	searchSwitch?.addEventListener(
		"click",
		(event) => {
			event.preventDefault();
			void ensureSearchScript().then(() => {
				window.requestAnimationFrame(() => {
					searchSwitch.click();
				});
			});
		},
		{ once: true },
	);

	desktopInput?.addEventListener("focus", () => {
		void ensureSearchScript();
	}, { once: true });

	mobileInput?.addEventListener("focus", () => {
		void ensureSearchScript();
	}, { once: true });

	desktopBar?.addEventListener(
		"pointerdown",
		(event) => {
			if (document.activeElement === desktopInput) {
				return;
			}
			event.preventDefault();
			void ensureSearchScript().then(() => {
				window.requestAnimationFrame(() => {
					desktopInput instanceof HTMLInputElement && desktopInput.focus();
				});
			});
		},
		{ once: true, passive: false },
	);

	mobileBar?.addEventListener(
		"pointerdown",
		(event) => {
			if (document.activeElement === mobileInput) {
				return;
			}
			event.preventDefault();
			void ensureSearchScript().then(() => {
				window.requestAnimationFrame(() => {
					mobileInput instanceof HTMLInputElement && mobileInput.focus();
				});
			});
		},
		{ once: true, passive: false },
	);
</script>
