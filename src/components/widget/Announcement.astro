---
import MarkdownIt from "markdown-it";
import { announcementConfig } from "../../config";

const config = announcementConfig;

if (!config.enable) {
	return null;
}

const md = new MarkdownIt({
	html: true,
	linkify: true,
	typographer: true,
	breaks: true,
});

const htmlContent = md.render(config.content);
---

<div class="card-base p-4">
	<div class="announcement-content text-sm text-75" set:html={htmlContent} />
</div>

<style is:global>
.announcement-content > :first-child {
	margin-top: 0;
}

.announcement-content > :last-child {
	margin-bottom: 0;
}

.announcement-content :where(h1, h2, h3, h4, h5, h6, strong) {
	color: rgb(23 23 23 / 0.9);
}

.dark .announcement-content :where(h1, h2, h3, h4, h5, h6, strong) {
	color: rgb(250 250 250);
}

.announcement-content :where(p, ul, ol, li) {
	color: rgb(64 64 64);
}

.dark .announcement-content :where(p, ul, ol, li) {
	color: rgb(212 212 212);
}

.announcement-content :where(p, ul, ol, blockquote) {
	margin: 0.5rem 0;
}

.announcement-content :where(ul, ol) {
	padding-left: 1.25rem;
}

.announcement-content a {
	color: var(--primary);
	text-decoration: none;
}

.announcement-content a:hover {
	text-decoration: underline;
}

.announcement-content code {
	color: var(--primary);
	background-color: rgb(245 245 245);
	border-radius: 0.25rem;
	padding: 0.125rem 0.25rem;
}

.dark .announcement-content code {
	background-color: rgb(38 38 38);
}

.announcement-content blockquote {
	border-left: 3px solid var(--primary);
	padding-left: 0.875rem;
	color: rgb(82 82 82);
}

.dark .announcement-content blockquote {
	color: rgb(163 163 163);
}
</style>
