{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "PNPM_CONFIG_PM_ON_FAIL=ignore pnpm install --frozen-lockfile",
	"buildCommand": "PNPM_CONFIG_PM_ON_FAIL=ignore pnpm run build",
	"headers": [
		{
			"source": "/",
			"headers": [
				{
					"key": "Link",
					"value": "</rss.xml>; rel=\"alternate\"; type=\"application/rss+xml\", </about/>; rel=\"about\"; type=\"text/html\""
				}
			]
		},
		{
			"source": "/_astro/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/pagefind/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, must-revalidate"
				}
			]
		},
		{
			"source": "/favicon/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/rss.xml",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		},
		{
			"source": "/robots.txt",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		},
		{
			"source": "/sitemap(.*).xml",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		}
	]
}
